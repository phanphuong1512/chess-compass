{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chess-compass",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-02-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "chess-compass-db",
      "database_id": "5c1add24-8a80-4155-9766-0d304cab7423"
    }
  ]
}
